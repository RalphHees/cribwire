# Copy to .env for local runs. Never commit real credentials — production
# secrets come from a secrets manager (backend.md §6).

NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

DATABASE_URL=postgres://cribwire:cribwire@localhost:5432/cribwire
# Required in production; without it the nonce cache and rate limits are
# per-process only.
REDIS_URL=redis://localhost:6379/0

# Used by the integration test suite.
TEST_DATABASE_URL=postgres://cribwire:cribwire@localhost:5432/cribwire_test
TEST_REDIS_URL=redis://localhost:6379/1

# Protocol limits (defaults shown).
PAIRING_TTL_SECONDS=600
AUTH_WINDOW_SECONDS=60
MAX_VIEWERS_PER_PAIRING=5
MAX_BODY_BYTES=16384
MAX_WS_MESSAGE_BYTES=16384
WS_HEARTBEAT_SECONDS=30
WS_IDLE_TIMEOUT_SECONDS=300
# How long the signaling hub reuses a pairing's cached device roster. Raising it
# cuts database reads further; lowering it shortens the window in which a
# revocation performed on another instance is still invisible to this one.
WS_ROSTER_TTL_SECONDS=30
EVENT_MIN_INTERVAL_SECONDS=30

# Prometheus scrape endpoint. Same value as PORT serves /metrics on the API
# listener; a different value starts a second listener for it.
METRICS_PORT=8080

# TURN (coturn `use-auth-secret`). Required in production; without them
# POST /v1/pairings/{id}/turn-credentials answers 503.
TURN_SHARED_SECRET=dev-turn-secret
TURN_TTL_SECONDS=3600
TURN_URIS=turn:localhost:3478?transport=udp,turns:localhost:5349?transport=tcp

# APNs provider token. Required in production. APNS_KEY_P8 is the contents of
# the .p8 file (PEM, newlines included) and never a path into the repository.
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.example.cribwire
APNS_TIMEOUT_MS=5000

# Rate limits (token buckets; the value is the hourly budget).
RATE_LIMIT_PAIRING_CREATE_PER_HOUR=10
RATE_LIMIT_CLAIM_PER_HOUR=20
RATE_LIMIT_PER_PAIRING_PER_HOUR=30
RATE_LIMIT_SIGNAL_UPGRADE_PER_HOUR=120
RATE_LIMIT_EVENTS_PER_HOUR=240
