      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze code bevat je versleutelingssleutel. Wie hem scant kan meekijken — toon hem alleen aan mensen die bij je in de kamer zijn."
          }
        }
      }
    },
    "This device will not tell you when the Camera hears or sees something. You can still watch the live view." : {
      "extractionState" : "manual",
      "localizations" : {
