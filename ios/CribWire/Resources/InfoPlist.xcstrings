        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CribWire"
          }
        }
      }
    },
    "NSAppleMusicUsageDescription" : {
      "comment" : "Privacy - Media Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "CribWire plays music through this phone's speaker so you can soothe your child from the paired device. It reads your playlists to offer them, and never sends your library or listening history to a server."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CribWire speelt muziek af via de luidspreker van deze telefoon, zodat je je kind kunt sussen vanaf het gekoppelde apparaat. De app leest je afspeellijsten om ze aan te bieden, en stuurt je bibliotheek of luistergeschiedenis nooit naar een server."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CribWire uses the camera to stream your child's room to your paired device, and to scan the pairing QR code. Video never leaves your devices unencrypted."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CribWire gebruikt de camera om de kamer van je kind naar je gekoppelde apparaat te streamen en om de QR-koppelcode te scannen. Video verlaat je apparaten nooit onversleuteld."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CribWire connects directly to your paired device over your local network, so video stays in your home whenever possible."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CribWire verbindt rechtstreeks met je gekoppelde apparaat via je lokale netwerk, zodat video waar mogelijk in huis blijft."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CribWire uses the microphone to stream room audio and to detect noise on this device. Audio is end-to-end encrypted and is never sent to a server in the clear."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CribWire gebruikt de microfoon om kamergeluid te streamen en om geluid op dit apparaat te detecteren. Audio is end-to-end versleuteld en gaat nooit onversleuteld naar een server."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CribWire saves the snapshots you take of the live view to your photo library. It never reads your existing photos."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CribWire bewaart de momentopnamen die je van het livebeeld maakt in je fotobibliotheek. Bestaande foto's worden nooit gelezen."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
